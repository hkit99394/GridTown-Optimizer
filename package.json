{
  "name": "city-builder",
  "version": "1.0.0",
  "description": "City builder optimizer - maximize population with roads, services, and residentials",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "web": "npm run build && node dist/webServer.js",
    "solve": "tsc && node dist/cli.js",
    "solve:auto": "tsc && node dist/cli.js auto",
    "solve:greedy": "tsc && node dist/cli.js greedy",
    "solve:cp-sat": "tsc && node dist/cli.js cp-sat",
    "solve:lns": "tsc && node dist/cli.js lns",
    "benchmark:greedy": "npm run build && node dist/greedyBenchmarkCli.js",
    "benchmark:cp-sat": "npm run build && node dist/cpSatBenchmarkCli.js",
    "benchmark:lns": "npm run build && node dist/lnsBenchmarkCli.js",
    "benchmark:labels": "npm run build && node dist/learnedRankingLabelCli.js",
    "benchmark:road-semantics": "npm run build && node dist/roadSemanticsScorecardCli.js",
    "benchmark:product-workflows": "npm run build && node dist/productWorkflowBenchmarkCli.js",
    "benchmark:service-master": "npm run build && node dist/serviceMasterBenchmarkCli.js",
    "benchmark:scorecard": "npm run build && node dist/crossModeBenchmarkCli.js",
    "experiment-registry": "npm run build && node dist/experimentRegistryCli.js",
    "experiment-registry:check": "npm run build && node dist/experimentRegistryCli.js check",
    "setup:cp-sat": "bash scripts/setup-cp-sat.sh",
    "test:acceptance": "node tests/acceptance/city-builder-bdd.test.cjs",
    "test": "npm run build && npm run test:acceptance && node tests/review-findings.test.cjs && node tests/experiment-registry.test.cjs && node tests/web-server-routes.test.cjs && node tests/optimizers.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.3.0"
  }
}
